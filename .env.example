# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Telegram-бот
TELEGRAM_BOT_TOKEN=123456:replace-me
TELEGRAM_WEBHOOK_SECRET=replace-with-random-string

# Офис: координаты и радиус допуска (метры)
OFFICE_LAT=55.751244
OFFICE_LNG=37.618423
OFFICE_RADIUS_M=100

# Сессия отметки (секунды с момента нажатия «Я на работе»)
SESSION_TTL_SECONDS=300

# Проверка жеста (0 / false — отключить)
REQUIRE_GESTURE=true

# Сервис распознавания лиц (face-service/app.py)
FACE_SERVICE_URL=http://127.0.0.1:8001

# Администрирование (Authorization: Bearer <ADMIN_TOKEN>)
ADMIN_TOKEN=replace-with-admin-token

# Часовой пояс серверного времени отметки
APP_TIMEZONE=Europe/Moscow

# Google Sheets: листы «Учёт» и «Аудит»
GOOGLE_SHEETS_ID=
# JSON сервисного аккаунта или его base64
GOOGLE_SERVICE_ACCOUNT_JSON=
